{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "remoteCache": {
    "enabled": false
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },

    "typegen": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "typegen"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
